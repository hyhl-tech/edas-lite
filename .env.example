# ---------------------------------------------------------------------------
# EDAS Lite (EasyDomainAPI System Lite)
# 复制本文件为 .env 后填写。composer create-project 会自动完成复制。
# 不要把真实的 .env 提交到版本库。
# ---------------------------------------------------------------------------

# EDAS 自身鉴权密钥（不是注册商密钥）。生成方式：openssl rand -hex 32
APP_KEY=

# 是否输出详细异常栈。生产环境必须为 false
APP_DEBUG=false

# 调用注册商接口的超时秒数
HTTP_TIMEOUT=30

# SQLite 数据库文件路径，相对项目根目录或绝对路径
DB_PATH=storage/edas.sqlite

# --- NameSilo ---------------------------------------------------------------
# 在 NameSilo 后台 API Manager 生成，并把服务器公网 IP 加入白名单
NAMESILO_API_KEY=

# --- Name.com ---------------------------------------------------------------
# NAMECOM_TOKEN 是后台 API Token 页面生成的令牌，不是登录密码
NAMECOM_USERNAME=
NAMECOM_TOKEN=
NAMECOM_API_BASE=https://api.name.com

# --- DomainNameAPI ----------------------------------------------------------
DOMAINNAMEAPI_RESELLER_ID=
DOMAINNAMEAPI_API_KEY=
DOMAINNAMEAPI_API_BASE=https://api.domainresellerapi.com

# --- 路由 -------------------------------------------------------------------
# 只列已配置凭证的注册商，逗号分隔，靠前的优先
REGISTRAR_PRIORITY=namesilo,namecom

# 智能比价开关：true 时在未显式指定 registrar 的情况下按注册价从低到高排序
SMART_PRICE_ROUTING=false

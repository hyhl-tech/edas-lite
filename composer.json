{
    "name": "hyhl-tech/edas-lite",
    "description": "EDAS Lite (EasyDomainAPI System Lite) - a self-hosted unified registrar API layer for NameSilo, Name.com and DomainNameAPI.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://zxynb.com.cn",
    "authors": [
        {
            "name": "华阳互联",
            "homepage": "https://zxynb.com.cn"
        }
    ],
    "support": {
        "issues": "https://github.com/hyhl-tech/edas-lite/issues",
        "source": "https://github.com/hyhl-tech/edas-lite"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Edas\\Lite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Edas\\Lite\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/edas"
    ],
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php migrations/run.php"
        ],
        "test": "phpunit",
        "migrate": "@php migrations/run.php",
        "health": "@php bin/edas health"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
